# Copy to .env and fill in. Loaded by the Makefile / shell (not auto-loaded by the app,
# which reads real environment variables — see boot/boot.py).

# ---- Core ----
PORT=8080
STOREFRONT_BASE=https://demo.inelabteamdev.com
HEADLESS=true
SELF_TICK=true
# Job runner lanes: manual = user "Refresh" (instant), scheduled = cron queue.
MANUAL_TRACK_THREADS=1
SCHEDULED_TRACK_THREADS=1
SCRAPE_MAX_ATTEMPTS=3
SCRAPE_TIMEOUT_MS=45000
# How long to wait for the price block after the reveal click (can be slow).
SCRAPE_REVEAL_TIMEOUT_MS=300000
# Per-check wait for the usually-absent cookie banner (was 2500ms).
COOKIE_BANNER_TIMEOUT_MS=1000
# Reuse one browser per worker thread; recycle after N scrapes; layout TTL.
SCRAPE_BROWSER_REUSE=true
SCRAPE_BROWSER_RECYCLE=25
SCRAPE_LAYOUT_TTL_SECONDS=300
# Per-product wall-clock cap (attempts included; 0 disables) and how many
# products to scrape concurrently in one browser. Keep this >= the reveal
# timeout or the reveal setting gets clipped.
SCRAPE_PRODUCT_BUDGET_MS=360000
SCRAPE_PAGE_CONCURRENCY=2
MIN_REFRESH_MINUTES=10
DEFAULT_REFRESH_MINUTES=120
ALLOWED_REFRESH_MINUTES=10,30,60,120
HISTORY_MAX_POINTS=20000
# Only used by /cron/tick?drain=true (the default is fire-and-forget).
CRON_INLINE_BUDGET_SECONDS=25
# Retries: 0 = retry a failed job until it passes (never dropped). Backoff
# grows exponentially up to JOB_RETRY_MAX_BACKOFF_SECONDS.
JOB_MAX_ATTEMPTS=0
JOB_RETRY_BACKOFF_SECONDS=30
JOB_RETRY_MAX_BACKOFF_SECONDS=600

# ---- Django ----
DJANGO_DEBUG=true
ALLOWED_HOSTS=*

# ---- Database (local docker-compose default) ----
DATABASE_URL=postgresql://pricedb:pricedb@127.0.0.1:5432/pricedb
# Supabase: use the TRANSACTION pooler (:6543) for the app. It multiplexes many
# clients over few server connections; the session pooler (:5432) caps at 15 and
# is easily exhausted. Prepared statements are auto-disabled for pooler hosts.
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Optional: a direct/session connection used ONLY for migrations (Docker start):
#   DIRECT_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Tuning (defaults are pooler-safe):
#   DB_CONN_MAX_AGE=0
#   DB_DISABLE_PREPARED_STATEMENTS=false

# ---- Auth / cron ----
JWTKEY=change-me-in-prod
CRON_SECRET=change-me-in-prod
CORS_ORIGINS=http://localhost:5173
# Optional comma-separated regexes, e.g. for Vercel preview deployments:
# CORS_ORIGIN_REGEXES=^https://.*\.vercel\.app$

# ---- Email ----
# Local dev: plain SMTP works (nothing is blocked on your machine).
# Render FREE web services block outbound SMTP ports 25/465/587, so there set:
#   EMAIL_PROVIDER=brevo
#   EMAIL_API_KEY=<Brevo API key>
#   SMTP_FROM=<verified sender address>
# Supported providers: smtp, brevo, sendgrid, resend. Provider-specific key
# names (BREVO_API_KEY / SENDGRID_API_KEY / RESEND_API_KEY) are also accepted.
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
# Only alert on out-of-stock -> in-stock; price-drop alerts are suppressed.
EMAIL_BACK_IN_STOCK_ONLY=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
SMTP_FROM=you@gmail.com
SMTP_FROM_NAME=Price Tracker
