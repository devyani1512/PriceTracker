# Copy to .env and fill in. Loaded by the Makefile / shell (not auto-loaded by the app,
# which reads real environment variables — see boot/boot.py).

# ---- Core ----
PORT=8080
STOREFRONT_BASE=https://demo.inelabteamdev.com
HEADLESS=true
SELF_TICK=true
# Job runner lanes: manual = user "Refresh" (instant), scheduled = cron queue.
MANUAL_TRACK_THREADS=1
SCHEDULED_TRACK_THREADS=1
SCRAPE_MAX_ATTEMPTS=3
SCRAPE_TIMEOUT_MS=45000
MIN_REFRESH_MINUTES=10
DEFAULT_REFRESH_MINUTES=120
ALLOWED_REFRESH_MINUTES=10,30,60,120
HISTORY_MAX_POINTS=20000
# Keep under cron-job.org's 30s free-tier request timeout.
CRON_INLINE_BUDGET_SECONDS=25

# ---- Django ----
DJANGO_DEBUG=true
ALLOWED_HOSTS=*

# ---- Database (local docker-compose default) ----
DATABASE_URL=postgresql://pricedb:pricedb@127.0.0.1:5432/pricedb
# Supabase: use the TRANSACTION pooler (:6543) for the app. It multiplexes many
# clients over few server connections; the session pooler (:5432) caps at 15 and
# is easily exhausted. Prepared statements are auto-disabled for pooler hosts.
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Optional: a direct/session connection used ONLY for migrations (Docker start):
#   DIRECT_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Tuning (defaults are pooler-safe):
#   DB_CONN_MAX_AGE=0
#   DB_DISABLE_PREPARED_STATEMENTS=false

# ---- Auth / cron ----
JWTKEY=change-me-in-prod
CRON_SECRET=change-me-in-prod
CORS_ORIGINS=http://localhost:5173
# Optional comma-separated regexes, e.g. for Vercel preview deployments:
# CORS_ORIGIN_REGEXES=^https://.*\.vercel\.app$

# ---- Email (Gmail app password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
SMTP_FROM=you@gmail.com
SMTP_FROM_NAME=Price Tracker
